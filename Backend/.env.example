# ── Server ─────────────────────────────────────────────────────────────────
# Local development only. Vercel sets PORT automatically.
PORT=4000

# REQUIRED in production. Use a long random string (e.g. `openssl rand -hex 32`).
# Leave empty for local development (a dev-only fallback is used).
JWT_SECRET=

# Comma-separated origins allowed to call the API (no trailing slashes).
# Example: https://vintage-store.vercel.app,https://vintage-admin.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────
# Leave BOTH empty to use the local SQLite file at data/vintage.db.
# To use Turso: create a DB (`turso db create vintage`), paste its URL here,
# and generate a token (`turso db tokens create vintage`).
# Example URL: libsql://vintage-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Seeded admin account ───────────────────────────────────────────────────
# In production these must be set explicitly or the default admin is NOT created.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Image storage (Cloudinary) ─────────────────────────────────────────────
# Required for uploads on Vercel. Create a free account at https://cloudinary.com.
# Leave empty to keep storing uploads on disk during local development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth (optional) ────────────────────────────────────────────────
# Authorized redirect URI: <API_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Facebook OAuth (optional) ──────────────────────────────────────────────
# Valid OAuth Redirect URI: <API_URL>/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback
