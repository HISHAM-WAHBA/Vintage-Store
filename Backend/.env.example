# Server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Seeded admin account
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@vintage.test
ADMIN_PASSWORD=Admin@1234

# Google OAuth (optional) — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Facebook OAuth (optional) — create an app at https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: http://localhost:4000/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback
