{
  "name": "vintage-backend",
  "version": "1.0.0",
  "description": "Node.js + SQLite (Turso) REST API for the Vintage storefront",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch --no-warnings server.js",
    "start": "node --no-warnings server.js",
    "reseed": "node --no-warnings src/reseed.js",
    "db:backup": "node --no-warnings scripts/backup-local-db.js",
    "db:migrate": "node --no-warnings scripts/migrate-to-turso.js",
    "db:verify": "node --no-warnings scripts/migrate-to-turso.js --verify-only",
    "test:api": "node --no-warnings scripts/smoke-test.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  }
}
