# Leave empty in local development — Vite proxies /api to http://localhost:4000.
# On Vercel set this to the deployed API URL, e.g.
# VITE_API_BASE=https://vintage-api.vercel.app/api
VITE_API_BASE=

# Public storefront URL — used for canonical URLs, Open Graph and sitemap.
# No trailing slash. Update this if the store domain changes, then redeploy.
VITE_SITE_URL=https://vintage-black-six.vercel.app
